APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Guatemala
APP_URL=https://tu-dominio.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_db_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=your_mail_host
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# IA Providers
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1

GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1

# reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# FFmpeg (para procesamiento de audio)
FFMPEG_PATH=ffmpeg

# n8n + Telegram — Notificaciones de agenda
# Webhook URL del workflow "Asistente - Telegram Recordatorios" en n8n
N8N_TELEGRAM_WEBHOOK_URL=https://n8n.tu-dominio.com/webhook/telegram-asistente
# Token secreto para autenticar las peticiones Laravel → n8n (generar con: openssl rand -hex 32)
N8N_WEBHOOK_SECRET=
# Username del bot de Telegram (se muestra en /settings)
TELEGRAM_BOT_USERNAME=@TuBotTelegram

# Recordatorios contextuales (plan RC). Apagados hasta autorizar el piloto.
REMINDERS_HERMES_API_ENABLED=false
REMINDERS_MOBILE_API_ENABLED=false
REMINDERS_CONTEXTUAL_DISPATCH_ENABLED=false
REMINDERS_ROUTINE_DISPATCH_ENABLED=false
# Corte ISO 8601 para el despacho nuevo de rutinas, p. ej. 2026-10-01T00:00:00-06:00
REMINDERS_ROUTINE_DISPATCH_CUTOVER_AT=
# IDs de device_tokens del piloto (un solo teléfono)
REMINDERS_DISPATCH_DEVICE_IDS=

# F2-02: agenda por herramientas del modelo (solo OpenAI). Apagado hasta la evaluación real.
AGENDA_TOOLS_ENABLED=false
REMINDERS_RETENTION_PURGE_ENABLED=false
